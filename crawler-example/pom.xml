<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.deripas</groupId>
        <artifactId>task-grid</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!--
        Crawler built on task-grid: an example application, not a library.
          fetcher-api  fetcher.proto - the handler protocol shared by fetcher and url-manager
          fetcher      handler: gRPC server over Apache HttpClient, runs behind handler-sidecar
          url-manager  Spring Boot application: client protocol (REST, RabbitMQ), task queue, dispatcher
    -->
    <artifactId>crawler-example</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>fetcher-api</module>
        <module>fetcher</module>
        <module>url-manager</module>
    </modules>

    <properties>
        <wiremock.version>3.13.2</wiremock.version>
        <awssdk.version>2.57.9</awssdk.version>
        <pekko-persistence-cassandra.version>1.1.0</pekko-persistence-cassandra.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.deripas</groupId>
                <artifactId>fetcher-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.deripas</groupId>
                <artifactId>fetcher</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
                Versions of task-grid (gRPC, JUnit) win over the Spring Boot BOM: the first import of an artifact
                wins, and gRPC stubs are generated with the plugin of ${grpc.version}. protobuf-java is managed directly in the root.
            -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- journal of the cluster mode of url-manager: Cassandra / ScyllaDB -->
            <dependency>
                <groupId>org.apache.pekko</groupId>
                <artifactId>pekko-persistence-cassandra_${scala.binary.version}</artifactId>
                <version>${pekko-persistence-cassandra.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
