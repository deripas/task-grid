{
  "priority": 10,
  "request": {
    "method": "GET",
    "urlPattern": "/.*"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/html"
    },
    "body": "page {{request.host}}{{request.url}}",
    "fixedDelayMilliseconds": 100,
    "transformers": ["response-template"]
  }
}
